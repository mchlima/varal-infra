#!/usr/bin/env bash
# Publica uma versão da API: carrega a imagem da entrada padrão, aplica as migrations num
# container temporário e só então troca o varal-api. Se a versão nova não ficar saudável,
# volta para a anterior.
set -euo pipefail
readonly VERSION="$1" DIR=/opt/varal IMAGE=varal-web-api
readonly STATE="$DIR/state/api-version"

echo "==> carregando a imagem $IMAGE:$VERSION"
gzip -dc | docker load -q
docker image inspect "$IMAGE:$VERSION" >/dev/null

echo "==> migrations"
docker run --rm --network postgres --env-file "$DIR/.env" -e NODE_ENV=production \
  "$IMAGE:$VERSION" node_modules/.bin/prisma migrate deploy

previous="$(cat "$STATE" 2>/dev/null || true)"
echo "==> subindo $VERSION (anterior: ${previous:-nenhuma})"
if API_VERSION="$VERSION" docker compose -f "$DIR/compose.yml" --project-directory "$DIR" up -d --wait --wait-timeout 90 api; then
  echo "$VERSION" >"$STATE"
else
  echo "!! $VERSION não ficou saudável" >&2
  docker logs --tail 50 varal-api >&2 || true
  if [[ -n "$previous" ]]; then
    echo "==> voltando para $previous" >&2
    API_VERSION="$previous" docker compose -f "$DIR/compose.yml" --project-directory "$DIR" up -d --wait --wait-timeout 90 api
  fi
  exit 1
fi

# Mantém as 3 imagens mais recentes da API.
docker image ls "$IMAGE" --format '{{.Tag}}' | sort -V -r | tail -n +4 | xargs -r -I{} docker image rm "$IMAGE:{}" >/dev/null
echo "==> API $VERSION no ar"
