# Variáveis da API em produção. No VPS: /opt/varal/.env (dono root, grupo deploy, permissão 640).
# Os valores reais ficam só no VPS e nas credenciais locais, nunca no git.
DATABASE_URL=postgresql://varal:<senha>@postgres:5432/varal
CORS_ORIGINS=https://varal.kratinho.com.br,https://admin-varal.kratinho.com.br
AUTH_PANEL_JWT_SECRET=<48 caracteres aleatórios>
AUTH_ADMIN_JWT_SECRET=<48 caracteres aleatórios, diferente do anterior>
EMAIL_PAYLOAD_SECRET=<48 caracteres aleatórios>
SMTP_HOST=smtplw.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<usuário SMTP Locaweb>
SMTP_PASSWORD=<senha SMTP Locaweb>
SMTP_FROM=Varal <nao-responda@kratinho.com.br>
SUPPORT_CONTACT=
PANEL_URL=https://varal.kratinho.com.br
ADMIN_URL=https://admin-varal.kratinho.com.br
